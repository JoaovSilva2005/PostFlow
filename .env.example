VITE_SUPABASE_URL=https://SEU-PROJETO.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=SUA_CHAVE_PUBLICAVEL
# Backend-only: usada pelos repositórios para acessar o banco no servidor.
# Nunca use o prefixo VITE_ nesta chave e nunca a envie para o navegador.
SUPABASE_SERVICE_ROLE_KEY=
# Compatibilidade com o nome de segredo usado por alguns projetos Supabase.
SUPABASE_SECRET_KEY=
# No desenvolvimento local, a API Express usa a porta 3001.
# Na Vercel, remova esta variável ou defina o valor como /api.
VITE_API_URL=http://localhost:3001/api
# api é o padrão seguro. Use demo somente em desenvolvimento local explícito.
# Nunca coloque chaves de provedores de IA em variáveis VITE_.
VITE_AI_MODE=api
OPENAI_API_KEY=
# Modelos padrão também usados no PostFlow em produção.
OPENAI_TEXT_MODEL=gpt-6-luna
OPENAI_IMAGE_MODEL=gpt-image-2.5-flare
OPENAI_IMAGE_QUALITY_MODEL=gpt-image-2.5-sunburst
# Aplicada aos dois modelos de imagem. Valores: low, medium, high, xhigh, max, auto.
OPENAI_IMAGE_QUALITY=medium
OPENAI_IMAGE_SIZE=1024x1024
# O fluxo gera exatamente uma imagem por solicitação.
# Somente para uma apresentação local sem banco. Nunca habilite em produção.
POSTFLOW_ALLOW_DEMO_FALLBACK=false
API_PORT=3001
APP_URL=http://localhost:5173
# Opcionais: usados por npm run api:verify para testar o fluxo autenticado.
POSTFLOW_TEST_EMAIL=
POSTFLOW_TEST_PASSWORD=

# Publicação social direta: segredos EXCLUSIVOS do BFF, sem prefixo VITE_.
# Gerar 32 bytes aleatórios em base64, manter estável e guardar com segurança.
SOCIAL_TOKEN_ENCRYPTION_KEY=
# Segredo aleatório >=32 caracteres, também registrado no Supabase Vault.
SOCIAL_CRON_SECRET=
# Só habilitar depois de configurar e testar database/operations/social-publishing-cron.sql.
SOCIAL_SCHEDULER_ENABLED=false
# Facebook Pages. Selecionar uma versão suportada no painel da Meta.
META_APP_ID=
META_APP_SECRET=
META_GRAPH_VERSION=v26.0
# Credenciais do produto Instagram Login (não confundir com o ID do app Facebook).
INSTAGRAM_APP_ID=
INSTAGRAM_APP_SECRET=
# LinkedIn: habilitar Share on LinkedIn e Sign In with LinkedIn using OpenID Connect.
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
# TikTok: habilitar Login Kit e Content Posting API/Direct Post.
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Marcar true somente depois de concluir as verificações correspondentes.
TIKTOK_MEDIA_DOMAIN_VERIFIED=false
TIKTOK_DIRECT_POST_APPROVED=false
