{
  "name": "postflow",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "engines": {
    "node": "22.x"
  },
  "scripts": {
    "dev": "concurrently -k -n API,WEB -c magenta,cyan \"npm run start:api\" \"npm run dev:web\"",
    "dev:api": "tsx watch backend/index.ts",
    "dev:web": "vite",
    "start:api": "tsx backend/index.ts",
    "api:verify": "node scripts/api/verifyFinance.mjs",
    "build": "tsc -b && vite build",
    "lint": "oxlint",
    "typecheck": "tsc -b",
    "test": "vitest run && node scripts/database/testSchema.mjs && node scripts/database/testMigrationInventory.mjs",
    "test:watch": "vitest",
    "test:responsive": "node scripts/responsive-check.cjs",
    "db:verify": "node scripts/database/verifyConnection.mjs",
    "db:test-crud": "node scripts/database/testCrud.mjs",
    "db:migrations:check": "node scripts/database/testMigrationInventory.mjs",
    "format:check": "prettier --check .",
    "preview": "vite preview"
  },
  "dependencies": {
    "@fontsource/inter": "^5.3.0",
    "@supabase/supabase-js": "^2.112.4",
    "concurrently": "^10.0.5",
    "cors": "^2.8.6",
    "express": "^5.2.1",
    "lucide-react": "^1.31.0",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router": "^7.18.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@testing-library/dom": "^10.4.1",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.2",
    "@testing-library/user-event": "^14.6.3",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@types/supertest": "^7.2.1",
    "@vitejs/plugin-react": "^6.0.4",
    "jsdom": "^29.1.1",
    "oxlint": "^1.75.0",
    "playwright": "^1.63.0",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vitest": "^4.1.10"
  }
}
